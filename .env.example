# Copy to .env for local development (api/ loads this via python-dotenv).
# Render deploys set these as real environment variables — see render.yaml.

BRAND_NAME=Sixth Vital
FLASK_SECRET_KEY=dev-secret-change-me
ADMIN_PASSWORD=

# Postgres — leave unset locally to fall back to a SQLite file (api/dev.db)
DATABASE_URL=

# Stripe (test-mode keys during development)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Google Workspace (Gmail send + Calendar free/busy). Run `flask google-auth`
# locally once to mint GOOGLE_TOKEN_JSON after setting up an OAuth client.
GMAIL_SENDER_EMAIL=
GOOGLE_OAUTH_CLIENT_JSON=
GOOGLE_TOKEN_JSON=
GOOGLE_CALENDAR_ID=primary

# Quo (formerly OpenPhone) — optional, SMS steps are skipped entirely if unset
QUO_API_KEY=

# RPSAS Practice — the AI training platform. No stub mode: session creation
# returns a clean 503 until this is set (surrounding logic is fully testable
# without it — see api/tests/test_practice.py).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# Stripe subscription price ids (create these in the Stripe dashboard first)
STRIPE_PRICE_APPLICANT=
STRIPE_PRICE_PHYSICIAN=
STRIPE_PRICE_PROGRAM_SEAT=

COMPANY_MAILING_ADDRESS=522 W Riverside Ave, Ste N, Spokane, WA 99201
SITE_BASE_URL=http://localhost:8010
API_BASE_URL=http://localhost:5000

# Content engine (Phase 3). Transcription is local/self-hosted (faster-whisper
# or openai-whisper — content/ingest.py), so no key is needed for it.
# WHISPER_MODEL_SIZE is a model name/size, not a vendor key (e.g. tiny/base/small).
WHISPER_MODEL_SIZE=base
CONTENT_UPLOADS_DIR=
CONTENT_CLIPS_DIR=
# Buffer or Publer — optional, either schedules LinkedIn posts (LinkedIn's own
# API can't post to a personal profile). Leave both unset to run the approval
# queue fully locally: content/schedule.py marks items status="scheduled"
# without pushing anywhere, and logs that clearly.
BUFFER_API_KEY=
PUBLER_API_KEY=

# Ops (Phase 5) — Monday digest + nightly backup destination. No stub mode:
# both raise a clear RuntimeError if FOUNDER_EMAIL is unset rather than
# silently going nowhere.
FOUNDER_EMAIL=
# Backup upload target — pick ONE. Picked GitHub releases (simplest, no
# cloud account): eastonconnolly-dot/sixth-vital-backups, a private repo
# created for exactly this (empty until the nightly cron job starts
# pushing releases to it). Set the real value in Render's dashboard too —
# this file isn't read by Render (BACKUP_GITHUB_REPO is sync: false there).
BACKUP_GITHUB_REPO=eastonconnolly-dot/sixth-vital-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_BUCKET=
BACKUP_S3_ENDPOINT_URL=

# Hub tenant sync — see HUB_INTEGRATION.md at the repo root. Optional; leads
# only push into the Hub CRM once HUB_API_KEY and at least one
# HUB_PIPELINE_KEY_<TRACK> are set, which requires having actually run
# scripts/provision_rpsas_tenant.py against the Hub first.
HUB_API_BASE_URL=
HUB_API_KEY=
HUB_PIPELINE_KEY_APPLICANT=
HUB_PIPELINE_KEY_PHYSICIAN=
HUB_PIPELINE_KEY_PROGRAM=

# Outreach list builders (Phase 2). NPPES/HCAHPS/ACGME need no key at all
# (free public APIs / CSV import). Places and email enrichment degrade
# cleanly (empty results / no email found, logged clearly) when unset.
GOOGLE_PLACES_API_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=

# Sequence engine throttling — 80/day/mailbox, ramped over two weeks by
# default. Rarely needs overriding; here for tuning a specific mailbox's
# warm-up without a code change.
SEQUENCE_DAILY_SEND_CAP=80
SEQUENCE_RAMP_DAYS=14
SEQUENCE_RAMP_START_CAP=10

# Phase 6 onboarding / post-delivery automation. UPLOAD_STORAGE_DIR defaults
# to api/uploads/ locally if unset -- set it to a persistent-disk path on
# Render (local disk storage today; see api/INTEGRATION.md for the S3 swap
# note). PRINT_VENDOR_EMAIL is the "local vendor's email order" badge
# print-ordering destination -- no API key needed.
UPLOAD_STORAGE_DIR=
UPLOAD_MAX_BYTES=524288000
PRINT_VENDOR_EMAIL=
